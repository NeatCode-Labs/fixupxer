<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No internet permission required - privacy focused -->
    <!-- Remove permissions contributed by transitive libraries. FixupXer is offline. -->
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    
    <!-- Package visibility for Android 11+ -->
    <queries>
        <!-- Query for browsers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <!-- Query for common apps we might want to open -->
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
        <package android:name="app.revanced.android.youtube" />
        <package android:name="app.morphe.android.youtube" />
        <package android:name="com.instagram.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.substack.app" />
        <package android:name="com.amazon.mShop.android.shopping" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.zhiliaoapp.musically" />
    </queries>
    
    <application
        android:name=".FixupXerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FixupXer"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="35">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FixupXer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Activity to handle shared URLs -->
        <activity
            android:name=".ui.ShareActivity"
            android:theme="@style/Theme.FixupXer"
            android:label="@string/share_activity_name"
            android:parentActivityName=".MainActivity"
            android:noHistory="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ProcessTextActivity"
            android:exported="true"
            android:theme="@style/Theme.FixupXer.Translucent"
            android:label="@string/process_text_menu_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        
        <!-- Settings Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:theme="@style/Theme.FixupXer"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BrowserSettingsActivity"
            android:theme="@style/Theme.FixupXer"
            android:label="@string/browser_settings_title"
            android:parentActivityName=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FrontendSettingsActivity"
            android:theme="@style/Theme.FixupXer"
            android:label="@string/alternative_frontends_title"
            android:parentActivityName=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CustomRulesActivity"
            android:theme="@style/Theme.FixupXer"
            android:label="@string/custom_rules_title"
            android:parentActivityName=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RuleEditorActivity"
            android:theme="@style/Theme.FixupXer"
            android:label="@string/custom_rule_editor_title"
            android:parentActivityName=".ui.CustomRulesActivity"
            android:exported="false" />
        
        <!-- Browser mode alias - disabled by default -->
        <activity-alias
            android:name="${applicationId}.BrowserAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- v1.5.0: explicit browser-app declaration for OEM pickers (MIUI/HyperOS, OneUI, ColorOS) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        
    </application>

</manifest> 