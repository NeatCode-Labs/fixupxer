{
  "format": "fixupxer-custom-rules",
  "schemaVersion": 1,
  "appVersion": "2.1.0",
  "provenance": "Independently authored for FixupXer under GPL-3.0-or-later.",
  "rules": [
    {
      "id": "5e9f475c-afdb-481b-8ab0-65fafb03acb9",
      "name": "Extract Facebook outbound destination",
      "enabled": true,
      "sortOrder": 0,
      "phase": "pre_clean",
      "contexts": ["MAIN", "SHARE", "BROWSER"],
      "includeScope": {"type": "exact_host", "host": "l.facebook.com"},
      "excludeScopes": [],
      "action": {
        "type": "extract_redirect",
        "parameterName": "u",
        "ignoreCase": false,
        "decodeMode": "percent_once"
      },
      "stopAfterMatch": true,
      "testVectors": [
        {
          "input": "https://l.facebook.com/l.php?u=https%3A%2F%2Fexample.com%2Fpage",
          "expected": "https://example.com/page"
        }
      ]
    },
    {
      "id": "017998eb-6896-498f-8f96-2bd13bc7e181",
      "name": "Extract LinkedIn outbound destination",
      "enabled": true,
      "sortOrder": 1,
      "phase": "pre_clean",
      "contexts": ["MAIN", "SHARE", "BROWSER"],
      "includeScope": {"type": "domain_and_subdomains", "host": "linkedin.com"},
      "excludeScopes": [],
      "action": {
        "type": "extract_redirect",
        "parameterName": "url",
        "ignoreCase": false,
        "decodeMode": "percent_once"
      },
      "stopAfterMatch": true,
      "testVectors": [
        {
          "input": "https://www.linkedin.com/safety/go?url=https%3A%2F%2Fexample.com%2F",
          "expected": "https://example.com/"
        }
      ]
    }
  ]
}
