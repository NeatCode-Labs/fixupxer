<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/primary_light">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/accent_dark"
                android:startColor="@color/accent_light"
                android:type="linear" />
            <corners android:radius="@dimen/button_corner_radius" />
            <!-- Add a subtle shadow effect -->
            <padding
                android:bottom="@dimen/button_shadow_padding"
                android:left="@dimen/button_shadow_padding"
                android:right="@dimen/button_shadow_padding"
                android:top="@dimen/button_shadow_padding" />
        </shape>
    </item>
</ripple> 