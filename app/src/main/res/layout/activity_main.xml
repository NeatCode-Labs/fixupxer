<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit colorSurface background: on OEM dynamic palettes (One UI) the window
     background (colorBackground) is a different tone than the app bar's colorSurface,
     which shows up as a gray band below the title. Overdraw is accepted on purpose. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false"
    tools:ignore="Overdraw"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:stateListAnimator="@null"
        android:outlineProvider="none"
        app:liftOnScroll="false"
        app:liftOnScrollColor="?attr/colorSurface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/menu_overflow"
            app:contentInsetStart="0dp">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="@string/app_title"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:layout_marginStart="@dimen/margin_large"
                android:layout_marginEnd="@dimen/margin_large"
                android:paddingTop="@dimen/padding_medium"
                android:paddingBottom="@dimen/padding_medium" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/padding_medium"
            android:paddingEnd="@dimen/padding_medium"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/scroll_bottom_padding"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/footerTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- LinearLayout wrapper: SmartFooterHelper appends the footer here on
                 small screens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/flowContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true">

                <!-- Vertical flow line connecting the two nodes -->
                <View
                    android:id="@+id/flowLine"
                    android:layout_width="@dimen/flow_line_width"
                    android:layout_height="0dp"
                    android:background="?attr/colorOutlineVariant"
                    app:layout_constraintTop_toBottomOf="@id/nodeIn"
                    app:layout_constraintBottom_toTopOf="@id/nodeOut"
                    app:layout_constraintStart_toStartOf="@id/nodeIn"
                    app:layout_constraintEnd_toEndOf="@id/nodeIn" />

                <!-- Step 1: original link node + input card -->
                <ImageView
                    android:id="@+id/nodeIn"
                    android:layout_width="@dimen/flow_node_size"
                    android:layout_height="@dimen/flow_node_size"
                    android:background="@drawable/bg_flow_node_in"
                    android:padding="@dimen/flow_node_padding"
                    android:src="@drawable/ic_link"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/flow_step_original_desc"
                    app:layout_constraintTop_toTopOf="@id/inputCard"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/inputCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/flow_card_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/nodeIn"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="@dimen/flow_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/padding_medium"
                        android:paddingEnd="@dimen/padding_medium"
                        android:paddingTop="@dimen/padding_small"
                        android:paddingBottom="@dimen/padding_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_extra_small"
                            android:text="@string/original_url"
                            android:textSize="@dimen/text_size_tiny"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutUrl"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false"
                            app:boxBackgroundMode="none"
                            app:boxBackgroundColor="@android:color/transparent"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_paste"
                            app:endIconContentDescription="@string/paste_content_desc">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="top"
                                android:hint="@string/enter_url_to_process"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                android:inputType="textUri"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:textSize="@dimen/text_size_body"
                                android:autofillHints="url"
                                android:importantForAutofill="yes" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonProcess"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/cta_height"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginStart="@dimen/flow_gap"
                    android:text="@string/process_url"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/flow_card_radius"
                    app:icon="@drawable/ic_process"
                    app:iconGravity="textStart"
                    app:layout_constraintTop_toBottomOf="@id/inputCard"
                    app:layout_constraintStart_toEndOf="@id/nodeIn"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Step 2: result node + result card -->
                <ImageView
                    android:id="@+id/nodeOut"
                    android:layout_width="@dimen/flow_node_size"
                    android:layout_height="@dimen/flow_node_size"
                    android:background="@drawable/bg_flow_node_out"
                    android:padding="@dimen/flow_node_padding"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorOnPrimary"
                    android:contentDescription="@string/flow_step_result_desc"
                    app:layout_constraintTop_toTopOf="@id/processedUrlInclude"
                    app:layout_constraintStart_toStartOf="parent" />

                <include
                    android:id="@+id/processedUrlInclude"
                    layout="@layout/include_processed_url_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginStart="@dimen/flow_gap"
                    app:layout_constraintTop_toBottomOf="@id/buttonProcess"
                    app:layout_constraintStart_toEndOf="@id/nodeIn"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Platform toggles (above the action row for quicker reach) -->
                <include
                    android:id="@+id/togglesInclude"
                    layout="@layout/include_platform_toggles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    app:layout_constraintTop_toBottomOf="@id/processedUrlInclude"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Action row: runtime helper applies the selected physical hand layout. -->
                <LinearLayout
                    android:id="@+id/actionRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginStart="@dimen/flow_gap"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/togglesInclude"
                    app:layout_constraintStart_toEndOf="@id/nodeIn"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonOpen"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cta_height"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="@dimen/text_size_small"
                        app:iconSize="@dimen/icon_small_size"
                        app:iconPadding="5dp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:text="@string/open"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:icon="@drawable/ic_open_in_browser"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorOnSecondaryContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCopy"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cta_height"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="@dimen/text_size_small"
                        app:iconSize="@dimen/icon_small_size"
                        app:iconPadding="5dp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:text="@string/copy_url"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:icon="@drawable/ic_copy"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorOnSecondaryContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonShare"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cta_height"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="@dimen/text_size_small"
                        app:iconSize="@dimen/icon_small_size"
                        app:iconPadding="5dp"
                        android:text="@string/share"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorOnSecondaryContainer" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Progress overlay: centered over content, takes no layout space -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="?attr/colorPrimary"
            app:layout_constraintTop_toTopOf="@id/mainScrollView"
            app:layout_constraintBottom_toBottomOf="@id/mainScrollView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Footer with smart anchoring -->
        <TextView
            android:id="@+id/footerTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/footer_text"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_tiny"
            android:gravity="center"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/footer_link_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Secondary icon-only History action. DominantHandLayoutHelper anchors
             it to the requested physical edge; SmartFooterHelper controls only
             its vertical footer relationship. Zeroed insets keep the tonal
             background at the full 48dp touch target; gravity=center plus
             symmetric padding keep the icon optically centered. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonHistory"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="@dimen/min_touch_target_size"
            android:layout_height="@dimen/min_touch_target_size"
            android:layout_marginBottom="@dimen/margin_small"
            android:contentDescription="@string/history_title"
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="@dimen/icon_button_padding"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:icon="@drawable/ic_history"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:layout_constraintBottom_toTopOf="@id/footerTextView"
            app:layout_constraintLeft_toLeftOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
