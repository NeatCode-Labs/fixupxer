<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:id="@+id/customProxyInputLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/custom_proxy_dialog_margin_horizontal"
    android:layout_marginEnd="@dimen/custom_proxy_dialog_margin_horizontal"
    android:layout_marginTop="@dimen/custom_proxy_dialog_margin_top"
    android:hint="@string/instagram_proxy_add_hint"
    app:errorEnabled="true"
    app:helperText="@string/instagram_proxy_add_example">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/customProxyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:maxLines="1"
        android:imeOptions="actionDone" />

</com.google.android.material.textfield.TextInputLayout>
