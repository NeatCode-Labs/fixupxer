<?xml version="1.0" encoding="utf-8"?>
<!-- Single contextual platform row: shown when the current URL matches one platform. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/platformToggleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/margin_small"
        android:background="@drawable/toggle_background"
        android:padding="@dimen/toggle_padding"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/platformMonogram"
            android:layout_width="@dimen/platform_monogram_size"
            android:layout_height="@dimen/platform_monogram_size"
            android:background="@drawable/bg_platform_monogram"
            android:gravity="center"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:importantForAccessibility="no"
            tools:text="IG" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            android:orientation="vertical"
            tools:ignore="NestedWeights">

            <TextView
                android:id="@+id/platformTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="@string/embed_friendly_link" />

            <LinearLayout
                android:id="@+id/platformProxyRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/textViewPlatformProxyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    tools:text="Active: toinstagram.com." />

                <TextView
                    android:id="@+id/textViewChangeProxy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/min_touch_target_size"
                    android:minHeight="@dimen/min_touch_target_size"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:maxLines="1"
                    android:text="@string/change_proxy_link"
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/change_proxy_link_desc"
                    tools:ignore="RtlSymmetry" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPlatform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            tools:contentDescription="@string/convert_instagram_toggle_desc" />
    </LinearLayout>
</LinearLayout>
