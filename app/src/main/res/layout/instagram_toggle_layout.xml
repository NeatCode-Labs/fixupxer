<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/instagramToggleContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="@dimen/toggle_margin_top"
    android:layout_marginBottom="@dimen/toggle_margin_bottom"
    android:gravity="center_vertical"
    android:background="@drawable/toggle_background"
    android:padding="@dimen/toggle_padding"
    android:visibility="gone">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/convert_instagram_toggle"
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/primary"
        android:textStyle="bold" />

    <!-- SwitchCompat for Instagram toggle -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchInstagram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:contentDescription="@string/convert_instagram_toggle_desc" />
</LinearLayout> 