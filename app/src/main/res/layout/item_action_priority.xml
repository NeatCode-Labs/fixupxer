<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/padding_medium"
    android:gravity="center_vertical">
    
    <ImageView
        android:id="@+id/imageViewDragHandle"
        android:layout_width="@dimen/min_touch_target_size"
        android:layout_height="@dimen/min_touch_target_size"
        android:padding="@dimen/icon_button_padding"
        android:src="@drawable/ic_drag_handle"
        android:contentDescription="@string/drag_handle_description"
        android:layout_marginEnd="@dimen/padding_small"
        app:tint="?attr/colorOnSurfaceVariant" />
    
    <TextView
        android:id="@+id/textViewActionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="?attr/colorOnSurface" />
    
</LinearLayout> 